# ================================================================
#  Medical Diary — шаблон конфигурации
#
#  Скопируйте в .env и заполните своими значениями:
#      cp .env.example .env
#
#  ⚠️  .env содержит секреты и НЕ должен попадать в Git!
#  ⚠️  Никогда не вписывайте реальные ключи в этот шаблон.
# ================================================================

# Имя Docker-контейнера (используется в docker-compose.yml)
CONTAINER_NAME=medical-diary-app

# --- База данных ------------------------------------------------
# Путь к SQLite внутри контейнера.
# Обычно уже задан в образе; меняйте, только если понимаете зачем.
# Пример: /app/data/medical_diary.db
DATABASE_PATH=

# --- Сессии и безопасность --------------------------------------
# Секретный ключ сессий (ОБЯЗАТЕЛЬНО).
# Генерация:  openssl rand -hex 32
SECRET_KEY=

# Требовать HTTPS для cookie.
# Ставьте true, когда сервис закрыт обратным прокси с HTTPS.
SESSION_COOKIE_SECURE=false

# --- Первый администратор ---------------------------------------
# ВНИМАНИЕ: пароль применяется ТОЛЬКО при первой инициализации
# пустой БД. Далее пароль меняется в панели администратора.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- WebAuthn (Face ID / Touch ID) ------------------------------
# Заполните после настройки домена и HTTPS.
# Пример для домена diary.example.com:
#   WA_RP_ID=diary.example.com
#   WA_ORIGIN=https://diary.example.com
WA_RP_ID=
WA_ORIGIN=

# --- PDF ---------------------------------------------------------
# Путь к шрифту с поддержкой кириллицы для экспорта в PDF.
# Пример: /app/fonts/DejaVuSans.ttf
FONT_PATH=

# --- ИИ-ассистент GigaChat (опционально) ------------------------
# Включить ИИ-ассистента: true / false
GIGACHAT_AI_ENABLED=true

# Authorization-ключ GigaChat API.
# СЕКРЕТ: впишите реальное значение только в .env на сервере!
GIGACHAT_AUTH_KEY=

# Модель GigaChat
GIGACHAT_MODEL=GigaChat-3-Ultra

# Scope API-ключа
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Таймаут запросов к GigaChat, секунд
GIGACHAT_TIMEOUT_SECONDS=20

# Сколько последних записей отправлять ИИ в контекст
GIGACHAT_MAX_ENTRIES=120